# Copy to .env in this directory. Do not commit the copy.
# Compose sets POSTGRES_HOST from POSTGRES_* below. Do not set POSTGRES_HOST
# yourself unless you are pointing the app at an external Postgres.
#
# Characters @ : / # in POSTGRES_PASSWORD must be percent-encoded. Compose
# interpolates the password into the connection URL.

POSTGRES_USER=tfm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tfm

# Host port published on 127.0.0.1 for the cloudflared process on this machine.
# The app inside the container always listens on 8080.
PORT=8080

# Stable admin passphrase. When unset, a new one is printed on every start.
SERVER_ID=

# Optional. Pin a build instead of latest.
# TFM_IMAGE=dotnetdummy/terraforming-mars:sha-abcdef0
